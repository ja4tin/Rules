#!name=蔚来签到
#!desc=支持双保险：优先使用自动抓包数据，失效时支持手动传入 Token。详细运行情况请查看 Surge 工具中的“脚本日志”。
#!author=Ja4tin
#!system=ios
#!arguments = ManualToken:""
#!arguments-desc = ManualToken: [备用通道] 如果自动抓取失效，请在此粘贴你的最新 Token（平时请保持留空）。

[Script]
# 【通道一：自动抓包】
蔚来抓取Token = type=http-request,pattern=^https:\/\/gateway-front-external\.nio\.com\/moat\/.*\/checkin,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ja4tin/Rules/refs/heads/main/BOXJS/nio/nio_task.js

# 【通道二：每日签到脚本】
蔚来定时任务 = type=cron,cronexp="30 8 * * *",wake-system=1,script-path=https://raw.githubusercontent.com/ja4tin/Rules/refs/heads/main/BOXJS/nio/nio_task.js,argument="%ManualToken%"

[MITM]
hostname = %APPEND% gateway-front-external.nio.com


# https://raw.githubusercontent.com/ja4tin/Rules/refs/heads/main/BOXJS/nio/nio_task.js