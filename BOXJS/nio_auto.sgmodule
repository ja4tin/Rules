#!name=蔚来自动签到
#!desc=【JustinYe】自动抓取蔚来 App Token 并执行每日签到。不再需要 BoxJs。
#!category=JustinYe
#!system=ios

[Script]
# 自动抓取 Token (每次打开签到页时触发)
蔚来抓取Token = type=http-request,pattern=^https:\/\/gateway-front-external\.nio\.com\/moat\/.*\/checkin,requires-body=0,script-path=https://raw.githubusercontent.com/ja4tin/Rules/refs/heads/main/BOXJS/nio/nio_checkin.js

# 每日定时签到 (每天上午 8:30 执行)
蔚来每日签到 = type=cron,cronexp="30 8 * * *",wake-system=1,timeout=60,script-path=https://raw.githubusercontent.com/ja4tin/Rules/refs/heads/main/BOXJS/nio/nio_checkin.js

[MITM]
hostname = %APPEND% gateway-front-external.nio.com